{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "sistemagestionenag",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      ".git/**",
      "*.xls",
      "*.pdf",
      "*.log"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
