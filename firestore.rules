rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura pública a 'usuarios' para buscar el correo por username durante el login
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Permitir a cualquier empleado enviar solicitudes (create público)
    match /solicitudes_personal/{solicitudId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Para todas las demás colecciones (cotizaciones, bitacora_global, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
