rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura pública a 'usuarios' para buscar el correo por username durante el login
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Permitir a cualquier empleado enviar solicitudes (create público)
    match /solicitudes_personal/{solicitudId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;

      // Documentación de respaldo (base64). Create público solo junto con la
      // solicitud (mismo batch), únicamente PDF/JPEG y con tamaño limitado.
      match /adjuntos/{adjuntoId} {
        allow create: if !exists(/databases/$(database)/documents/solicitudes_personal/$(solicitudId))
                      && existsAfter(/databases/$(database)/documents/solicitudes_personal/$(solicitudId))
                      && request.resource.data.tipo in ['application/pdf', 'image/jpeg']
                      && request.resource.data.data is string
                      && request.resource.data.data.size() < 1000000;
        allow read, update, delete: if request.auth != null;
      }
    }

    // Consulta pública del estado (QR del comprobante). Solo lectura por ID exacto
    // (get), nunca listado. Contiene únicamente datos no sensibles.
    match /consulta_solicitudes/{solicitudId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if (request.auth != null)
                    || (!exists(/databases/$(database)/documents/solicitudes_personal/$(solicitudId))
                        && existsAfter(/databases/$(database)/documents/solicitudes_personal/$(solicitudId))
                        && request.resource.data.keys().hasOnly(['nombre', 'departamento', 'tipoSolicitud', 'fechaInicio', 'fechaFin', 'estado', 'observacionesRRHH', 'fechaCreacion', 'fechaActualizacion', 'cantidadAdjuntos'])
                        && request.resource.data.estado == 'Pendiente'
                        && request.resource.data.observacionesRRHH == '');
      allow update, delete: if request.auth != null;
    }
    
    // Consulta pública de Bienes Nacionales (para escaneo de etiquetas QR / Barra)
    match /bienes_nacionales/{bienId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    // Memorándums y Reportes Técnicos: lectura permitida para visualización de historial
    // y escritura por usuarios del sistema administrativo
    match /memorandums/{memoId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /reportes_tecnicos/{reporteId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Mesa de Ayuda TI (Helpdesk): Gestión de tickets de soporte técnico e incidencias
    match /tickets_soporte/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.codigo.size() <= 50
                    && request.resource.data.solicitante is string
                    && request.resource.data.solicitante.size() > 0
                    && request.resource.data.solicitante.size() <= 150
                    && request.resource.data.departamento is string
                    && request.resource.data.departamento.size() > 0
                    && request.resource.data.departamento.size() <= 150
                    && request.resource.data.asunto is string
                    && request.resource.data.asunto.size() > 0
                    && request.resource.data.asunto.size() <= 250
                    && request.resource.data.descripcion is string
                    && request.resource.data.descripcion.size() > 0
                    && request.resource.data.descripcion.size() <= 5000
                    && request.resource.data.estado == 'Nuevo';
      allow update, delete: if request.auth != null;
    }
    
    // Para todas las demás colecciones (cotizaciones, bitacora_global, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
